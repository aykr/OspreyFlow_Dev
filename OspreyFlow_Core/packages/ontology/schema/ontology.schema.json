{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ospreyflow/ontology.schema.json",
  "title": "OspreyFlow ontology",
  "description": "spec/01_DOMAIN_MODEL.md §1 — the YAML shape a deployment's ontology.yaml must validate against before the loader applies the nine-channel and pole_class rules that JSON Schema alone cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entity_types", "edge_types"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "entity_types": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entity_type" }
    },
    "edge_types": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge_type" }
    }
  },
  "$defs": {
    "property_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["string", "string[]", "date", "datetime", "integer", "float", "boolean", "enum"]
        },
        "indexed": { "type": "boolean" },
        "required": { "type": "boolean" },
        "sensitivity": { "type": "string", "enum": ["low", "medium", "high"] },
        "values": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blocking": { "type": "array", "items": { "type": "string" } },
        "comparisons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "entity_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "pole_class", "channel", "shape"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "pole_class": {
          "type": "string",
          "enum": ["person", "object", "location", "event", "organisation"]
        },
        "channel": {
          "type": "string",
          "enum": ["ochre", "rose", "plum", "violet", "indigo", "azure", "cyan", "jade", "moss"]
        },
        "shape": { "type": "string", "minLength": 1 },
        "icon": {
          "description": "The drawing inside the type's shape on the canvas (ADR-079 and ADR-128 Amendment 3): a name from this closed list, which the Glass holds the drawings for. Optional; an analyst may choose another for themselves in their own browser.",
          "type": "string",
          "enum": [
            "person", "people", "building", "bank", "phone", "mail", "device", "pin",
            "calendar", "document", "vehicle", "box", "key", "globe", "card", "shield",
            "flag", "link", "tag", "camera",
            "keypad", "account", "parcel-over-wall", "clash", "crowd", "magnifier"
          ]
        },
        "icon_by_value": {
          "description": "ADR-128 Decision 4: the icon chosen by the value of one enum property. `property` names an enum property of this type and `icons` maps some of its values to names from the closed `icon` list; a node without the property, or with a value not mapped, draws the type's `icon`. Checked at load that the property exists, is an enum and holds each mapped value.",
          "type": "object",
          "additionalProperties": false,
          "required": ["property", "icons"],
          "properties": {
            "property": { "type": "string", "minLength": 1 },
            "icons": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "$ref": "#/$defs/entity_type/properties/icon" }
            }
          }
        },
        "identifiers": { "type": "array", "items": { "type": "string" } },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property_def" } },
        "resolution": { "$ref": "#/$defs/resolution" }
      }
    },
    "edge_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "from", "to", "basis"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "from": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "to": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "directed": { "type": "boolean" },
        "temporal": { "type": "boolean" },
        "system": { "type": "boolean" },
        "basis": {
          "description": "ADR-081: direct (a loaded, established record stands behind a link of this type) or probabilistic (statistically derived, or an analyst's declaration). Required: there is no unclassified type. A Direct link is drawn solid and a Probabilistic one dotted; the style is not authored.",
          "type": "string",
          "enum": ["direct", "probabilistic"]
        },
        "colour": {
          "description": "ADR-081: the line colour, one of the nine data-channel names in design/tokens.css (the same closed list an entity type's channel uses). Optional.",
          "type": "string",
          "enum": ["ochre", "rose", "plum", "violet", "indigo", "azure", "cyan", "jade", "moss"]
        },
        "label": {
          "description": "ADR-091: the type's display name in sentence case (Communicated with); the name stays the stored key. Optional: without one the Glass derives it from the name.",
          "type": "string",
          "pattern": "\\S"
        },
        "thickness": {
          "description": "ADR-081: the line width at the default weight, a whole number from 1 to 5; a link's weight scales it. Optional.",
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property_def" } }
      }
    }
  }
}
