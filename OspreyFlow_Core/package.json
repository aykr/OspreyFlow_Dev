{
  "name": "ospreyflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/workspace",
    "apps/harness"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && cd ../OspreyFlow_Build && ../OspreyFlow_Core/node_modules/.bin/eslint -c ../OspreyFlow_Core/eslint.config.js tools",
    "test": "npm run test --workspace apps/workspace && npm run test --workspace apps/harness",
    "schemas:generate": "python3 packages/schemas/generate_ts.py",
    "licence-check": "node ../OspreyFlow_Build/tools/licence_check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "json-schema-to-typescript": "^15.0.3",
    "license-checker": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
