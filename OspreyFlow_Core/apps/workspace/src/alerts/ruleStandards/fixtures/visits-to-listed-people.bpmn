<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:osprey="https://ospreyflow.org/schema/rule/1" id="definitions" targetNamespace="https://ospreyflow.org/rules" exporter="OspreyFlow" exporterVersion="1"><bpmn:process id="rule" name="Visits to listed people" isExecutable="true"><bpmn:extensionElements><osprey:rule dataset="ds-prison-visits"/><osprey:when runs="post_commit" onHit="load"/></bpmn:extensionElements><bpmn:startEvent id="when" name="As data loads, after commit"><bpmn:outgoing>flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:sequenceFlow id="flow_1" sourceRef="when" targetRef="if"/><bpmn:businessRuleTask id="if" name="If a Person meets the conditions" implementation="https://www.omg.org/spec/DMN/20191111/MODEL/" osprey:decisionRef="decision"><bpmn:extensionElements><osprey:limits budgetMs="5000" maxMatches="200"/></bpmn:extensionElements><bpmn:incoming>flow_1</bpmn:incoming><bpmn:outgoing>flow_2</bpmn:outgoing></bpmn:businessRuleTask><bpmn:sequenceFlow id="flow_2" sourceRef="if" targetRef="then"/><bpmn:endEvent id="then" name="Raise a high alert"><bpmn:extensionElements><osprey:raise severity="high" team="case" scope="this_case"/></bpmn:extensionElements><bpmn:incoming>flow_2</bpmn:incoming></bpmn:endEvent></bpmn:process><bpmndi:BPMNDiagram id="diagram"><bpmndi:BPMNPlane id="plane" bpmnElement="rule"><bpmndi:BPMNShape id="when_di" bpmnElement="when"><dc:Bounds x="100" y="100" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="if_di" bpmnElement="if"><dc:Bounds x="190" y="78" width="120" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="then_di" bpmnElement="then"><dc:Bounds x="364" y="100" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1"><di:waypoint x="136" y="118"/><di:waypoint x="190" y="118"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2"><di:waypoint x="310" y="118"/><di:waypoint x="364" y="118"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>
