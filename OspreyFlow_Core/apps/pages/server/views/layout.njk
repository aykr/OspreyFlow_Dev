<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} · OspreyFlow</title>
</head>
<body>
<main>
{% block content %}{% endblock %}
</main>
{# The data block a page's interactive module reads (ADR-152 decision 1). It is data, not code: nothing here needs a script to run. #}
<script type="application/json" id="page-data" nonce="{{ cspNonce }}">{"page":"{{ page }}"}</script>
</body>
</html>
