{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "packages/schemas/generated/**/*.ts",
    "apps/workspace/src/**/*.ts",
    "apps/workspace/src/**/*.tsx",
    "apps/harness/src/**/*.ts",
    "apps/harness/src/**/*.tsx",
    "apps/harness/keyboard/**/*.ts",
    "apps/harness/keyboard/**/*.tsx"
  ]
}
