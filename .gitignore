.graphify/
graphify-out/

# macOS's own custom-folder-icon marker (a 0-byte file whose name ends in a literal carriage
# return, `Icon\r`) — this machine's own filesystem/sync tooling writes one into any directory it
# touches. `Icon?` matches it (`?` is any single character, including the trailing CR) without
# matching a real file named exactly `Icon`. Added after one reached a real commit
# (`tests/demo_registry/`) via a bare `git add <dir>`, not spotted until after `git commit`.
Icon?

# Python
.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/

# OspreyFlow_Data: every dataset and the Conduit's local analytics store (services/api/config.py's
# ANALYTICS_DB_PATH default) live here and nothing in it is ever committed, except the README that
# makes the folder exist in a clone (spec/06_DECISIONS.md ADR-054). `/data/` is the old location.
/OspreyFlow_Data/*
!/OspreyFlow_Data/README.md
/data/

# Internal-only demo datasets (spec/06_DECISIONS.md ADR-035, C1) — never committed, provisioned to
# OSPREYFLOW_INTERNAL_DEMO_DATA_DIR at runtime, referenced by filename from a demo's own manifest.
/demo-data/

# The real-data exceptions list (CLAUDE.md rule 9, process/07_BUILD_PLAN.md standing rule 3,
# spec/06_DECISIONS.md ADR-035 §C3) — never committed, so a clone never records which real
# datasets, if any, anyone has ever admitted locally. scripts/real_data_exceptions.py's own
# docstring has the mechanism; config/real_data_exceptions.example.yaml has the schema.
/config/real_data_exceptions.yaml

# Node
node_modules/
apps/workspace/dist/
apps/workspace/test-results/
apps/workspace/playwright-report/
apps/workspace/.env.local
apps/harness/dist/
apps/harness/test-results/
apps/harness/playwright-report/
.playwright-mcp/

# macOS — no leading slash: matches at every directory level, not only the
# repo root (`docs/.DS_Store` was tracked despite this rule because it
# predates it; untracking it is a one-time `git rm --cached`, not a rule fix)
.DS_Store

# Claude Code / Cowork session artifacts
Claude outputs/
.impeccable/
.claude/settings.local.json

# Rendered deployment artefacts (`python -m harness.render`, 06_DECISIONS.md ADR-049 Stage 2 §1).
# 05_DEPLOYMENT.md §2.1 says a real deployment versions these — but this repository is not a
# deployment: the committed osprey.yaml's own header calls itself "the demo/CI configuration" and
# says "A real deployment's own osprey.yaml is generated by the harness". Committing output
# rendered from it would assert the opposite. A deployment's own repository un-ignores this.
/deploy/generated/

# `python -m scripts.osprey_bundle` output (06_DECISIONS.md ADR-049 Stage 2 §5b) — a locally built
# distribution artefact, not something this repository ships of itself.
/dist/
