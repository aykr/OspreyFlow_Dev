{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mantisnexus/ontology.schema.json",
  "title": "MantisNexus ontology",
  "description": "docs/01_DOMAIN_MODEL.md §1 — the YAML shape a deployment's ontology.yaml must validate against before the loader applies the nine-channel and pole_class rules that JSON Schema alone cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entity_types", "edge_types"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "entity_types": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entity_type" }
    },
    "edge_types": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge_type" }
    }
  },
  "$defs": {
    "property_def": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["string", "string[]", "date", "datetime", "integer", "float", "boolean", "enum"]
        },
        "indexed": { "type": "boolean" },
        "required": { "type": "boolean" },
        "sensitivity": { "type": "string", "enum": ["low", "medium", "high"] },
        "values": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blocking": { "type": "array", "items": { "type": "string" } },
        "comparisons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "entity_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "pole_class", "channel", "shape"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "pole_class": {
          "type": "string",
          "enum": ["person", "object", "location", "event", "organisation"]
        },
        "channel": {
          "type": "string",
          "enum": ["ochre", "rose", "plum", "violet", "indigo", "azure", "cyan", "jade", "moss"]
        },
        "shape": { "type": "string", "minLength": 1 },
        "identifiers": { "type": "array", "items": { "type": "string" } },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property_def" } },
        "resolution": { "$ref": "#/$defs/resolution" }
      }
    },
    "edge_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "from", "to"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "from": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "to": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "directed": { "type": "boolean" },
        "temporal": { "type": "boolean" },
        "system": { "type": "boolean" },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property_def" } }
      }
    }
  }
}
