# GENERATED by `python -m harness.render` from osprey.yaml. Do not hand-edit —
# regenerate instead (spec/05_DEPLOYMENT.md §2.1). A hand edit is reported by
# `python -m harness.render --check` as drift, naming this path.

OSPREY_PROFILE=local-lite
OSPREY_RELEASE_VERSION=v0.4.12
OSPREY_STATE_DIR=/var/lib/osprey/state
OSPREY_GRAPH_STORE=arcadedb
OSPREY_ANALYTICS_ENGINE=duckdb
OSPREY_POST_INGEST_RESOLUTION=on
OSPREY_SEARCH_BACKEND=opensearch
OSPREY_DATA_ROOT=/var/lib/osprey/data
OSPREY_STAGING_ROOT=/var/lib/osprey/staging
OSPREY_BACKUP_ROOT=/var/lib/osprey/backups
OSPREY_INGEST_ROOT=/var/lib/osprey/ingest
OSPREY_ARCADEDB_HEAP=-Xms1G -Xmx8G -XX:+ExitOnOutOfMemoryError
ANALYTICS_DB_PATH=/var/lib/osprey/data/analytics.duckdb
OSPREY_IDENTITY_PROVIDER=keycloak
OSPREY_HANDLING_SCHEME=uk-law-enforcement
OSPREY_ONTOLOGY=default
OSPREY_REAL_DATA_EXCEPTIONS=config/real_data_exceptions.yaml
OSPREY_MODELS_LOCAL_ONLY=true
OSPREY_EXTRACTION_MODEL=qwen2.5:7b-instruct
OSPREY_VISION_MODEL=moondream:1.8b-v2-q4_K_M
OSPREY_TRANSCRIPTION_MODEL=Systran/faster-whisper-tiny.en
OSPREY_EMBEDDING_MODEL=all-minilm:22m-l6-v2-fp16
OIDC_AUDIENCE=osprey-conduit
CORS_ALLOWED_ORIGINS=http://ospreyflow.localhost
OSPREY_GLASS_ORIGIN=http://ospreyflow.localhost
OSPREY_IDENTITY_ORIGIN=http://id.ospreyflow.localhost
OSPREY_DASHBOARDS_ORIGIN=http://bi.ospreyflow.localhost
OSPREY_HOTLIST_AUDIENCE=only_me
OSPREY_HOTLIST_AUDIENCE_EDITABLE=true

# Ports published besides the front proxy's: the Conduit only when network.expose_conduit
# asks, ArcadeDB on loopback only (ADR-114 Amendment 4 decision 3). Each is overridable.
OSPREY_API_PORT=8000
OSPREY_ARCADEDB_PORT=2480
OSPREY_ARCADEDB_PASSWORD=held-osprey_arcadedb_password
OSPREY_KEYCLOAK_ADMIN_PASSWORD=held-osprey_keycloak_admin_password
OSPREY_KEYCLOAK_DB_PASSWORD=held-osprey_keycloak_db_password
OSPREY_MINIO_PASSWORD=held-osprey_minio_password
OSPREY_POSTGRES_PASSWORD=held-osprey_postgres_password
OSPREY_MODEL_KEY_GEMINI=held-gemini-key
