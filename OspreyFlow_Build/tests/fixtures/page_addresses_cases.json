{
 "about": "The table of cases for the page service's addresses, approved by the owner on 24 November 2026 with three changes (case 14 refuses IP and bracketed origins outright; case 19, an HTTPS origin on the proxy's plain-HTTP port; case 12 covers every port the proxy publishes). Read by tests/harness/test_page_addresses.py, tests/harness/test_page_addresses_caddy.py and apps/pages/test/server/pageAddresses.test.ts. A row is a configuration and what derive returns or its refusal's key words.",
 "secret_variable": "OSPREY_PAGES_CLIENT_SECRET",
 "rows": [
  {
   "case": 1,
   "id": "1-lite-plain-http",
   "label": "local-lite, plain HTTP on a .localhost name",
   "raised_in": "PL7a2b rounds 1, 3",
   "config": {
    "shape": "local-lite",
    "origin": "http://reference.ospreyflow.localhost:8081",
    "own_certificate": null,
    "expose_conduit": false,
    "redirect_http": false,
    "access_key": false,
    "pages": true,
    "complete_govuk_tree": false,
    "brand": "ospreyflow"
   },
   "expect": {
    "refuse": {
     "key": "needs_https",
     "error": "PageServiceNeedsHttps",
     "words": [
      "neither https nor a loopback address",
      "over plain HTTP"
     ],
     "names_setting": true
    }
   }
  },
  {
