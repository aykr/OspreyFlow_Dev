# The namespace's resources for OspreyFlow (ADR-148), generated by harness.render from
# osprey.yaml (profile: cloud-platform) — do not edit by hand. The providers, the backend
# and the tags are the namespace folder's own; the state is the platform's and holds the
# passwords made here. What the platform gives the namespace, read from its own outputs in
# the pull request:

variable "namespace" {
  type    = string
  default = "ospreyflow-poc"
}

variable "vpc_id" {
  type = string
}

variable "subnet_ids" {
  type = list(string)
}

variable "eks_oidc_provider_arn" {
  type = string
}

variable "eks_oidc_issuer" {
  type        = string
  description = "The cluster's OIDC issuer, without https://"
}
