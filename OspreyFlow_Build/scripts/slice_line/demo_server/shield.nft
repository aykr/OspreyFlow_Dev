#!/usr/sbin/nft -f
# The early-warning runner's shield (the owner's ruling of 21 November 2026): an outbound restriction on the runner's
# account only. Code under test, run as @USER@, cannot open a connection to anything listening on this machine or to
# its Docker networks. It may still use its own loopback servers (each binds port 0, so the system gives it a port in
# the ephemeral range, @EPHEMERAL@) and fetch packages over HTTPS from public addresses.
#
# One table of its own, in nftables' inet family: no chain that Docker, ufw or firewalld writes is touched, so a reload
# of any of them leaves this in place. It opens nothing: every account but @USER@ is accepted at the first rule, as if
# the table were not there, and nothing inbound is matched at all. install.sh fills in @USER@, @EPHEMERAL@ and @DNS@;
# osprey-early-shield.service loads it at boot; cleanup.sh deletes it. Each job also checks it before running anything:
# a connection to any port another account listens on must fail (runner.py, shield_breaches).
table inet osprey_early
delete table inet osprey_early

table inet osprey_early {
	set private4 {
		type ipv4_addr
		flags interval
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
			     192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/3 }
	}
	set private6 {
		type ipv6_addr
		flags interval
		elements = { ::/127, ::ffff:0:0/96, 64:ff9b::/96, fc00::/7, fe80::/10, ff00::/8 }
	}
	chain output {
		type filter hook output priority filter; policy accept;
		meta skuid != "@USER@" accept
		ct state established,related accept
		@DNS@
		oifname "lo" meta l4proto tcp th dport @EPHEMERAL@ accept
		meta l4proto tcp fib daddr type local reject with tcp reset
		fib daddr type local reject
		meta l4proto tcp ip daddr @private4 reject with tcp reset
		ip daddr @private4 reject
		meta l4proto tcp ip6 daddr @private6 reject with tcp reset
		ip6 daddr @private6 reject
		meta l4proto tcp th dport 443 accept
		meta l4proto tcp reject with tcp reset
		reject
	}
}
