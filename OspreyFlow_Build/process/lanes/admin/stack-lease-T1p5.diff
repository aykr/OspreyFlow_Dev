+        f'for a; do last="$a"; done\n'
+        f'case "$last" in *"nohup setsid"*|"bash -s -- "*) cd "{home}" && printf "%s\\n" "$in" | HOME="{home}" bash -c "$last";; esac\nexit 0\n'
+    )
