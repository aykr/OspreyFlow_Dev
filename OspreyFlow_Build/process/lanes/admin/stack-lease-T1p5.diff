+def _finished_run(home: Path) -> Path:
+    runs = home / "osprey-runs" / "case.meta" / "runs"
+    for _ in range(200):
+        done = [p for p in runs.iterdir() if p.name != "last" and (p / "exit").exists()] if runs.exists() else []
+        if done:
+            return done[0]
+        time.sleep(0.05)
+    raise AssertionError("the run never finished")
