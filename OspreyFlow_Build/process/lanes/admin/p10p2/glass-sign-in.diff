@@ -0,0 +1,42 @@
+// The top bar when the Conduit cannot say who the person is (ADR-148 Amendment 8): the words, *Try
+// again* and *Sign out*, on their own, for `account-unread.spec.ts` (rule 13) and the every-harness axe
+// scan in both themes and under GOV.UK (`?brand=govuk`). What each button did is recorded on
+// `window.__acted`.
+import { createRoot } from "react-dom/client";
+
+import "../src/design/tokens.css";
+import "../src/design/primitives.css";
+import "../src/shell/chrome.css";
+import { AccountUnread } from "../src/auth/AccountUnread";
+import { applyHarnessBrand } from "./brandHarness";
+
+await applyHarnessBrand();
+
+const acted: string[] = [];
+(window as unknown as { __acted: string[] }).__acted = acted;
+
+function Harness() {
+  return (
+    <header className="app-header top-bar" data-app="glass">
+      <h1 className="label" style={{ margin: 0 }}>
+        Account unread harness
+      </h1>
+      <div
+        className="app-header__account"
+        style={{
+          display: "flex",
+          alignItems: "center",
+          gap: "var(--sp-8)",
+          marginLeft: "auto",
+        }}
+      >
+        <AccountUnread
+          onTryAgain={() => acted.push("try-again")}
+          onSignOut={() => acted.push("sign-out")}
+        />
+      </div>
+    </header>
+  );
+}
+
+createRoot(document.getElementById("root")!).render(<Harness />);
diff --git a/OspreyFlow_Core/apps/workspace/keyboard/account-unread.spec.ts b/OspreyFlow_Core/apps/workspace/keyboard/account-unread.spec.ts
new file mode 100644
index 0000000..359dcdf
--- /dev/null
+++ b/OspreyFlow_Core/apps/workspace/keyboard/account-unread.spec.ts
@@ -0,0 +1,49 @@
+// The account-unread notice by keyboard alone (ADR-148 Amendment 8; `CLAUDE.md` rule 13): when the
+// Conduit cannot say who the person is, *Try again* and *Sign out* are each reached by Tab and pressed
+// with the keyboard. No `page.mouse`, no `.click()`.
+import { expect, test, type Page } from "@playwright/test";
+
+import {
+  ACCOUNT_UNREAD_ACTIONS,
+  assertAllCovered,
+  registerCovered,
+} from "./actionRegistry";
+
+const REGISTRY = "ACCOUNT_UNREAD_ACTIONS";
+const HARNESS = "/keyboard/account-unread-harness.html";
+
+function acted(page: Page): Promise<string[]> {
+  return page.evaluate(
+    () => (window as unknown as { __acted: string[] }).__acted,
+  );
+}
+
+test("the account is asked for again by keyboard when it could not be read", async ({
+  page,
+}) => {
+  await page.goto(HARNESS);
+  await expect(page.getByRole("alert")).toContainText(
+    "Your account could not be read just now",
+  );
+  await page.keyboard.press("Tab");
+  await expect(page.getByRole("button", { name: "Try again" })).toBeFocused();
+  await page.keyboard.press("Enter");
+  expect(await acted(page)).toEqual(["try-again"]);
+  registerCovered(REGISTRY, "try-reading-the-account-again-by-keyboard");
+});
+
+test("Sign out is reached by keyboard with no account read", async ({
+  page,
+}) => {
+  await page.goto(HARNESS);
+  await page.keyboard.press("Tab");
+  await page.keyboard.press("Tab");
+  await expect(page.getByRole("button", { name: "Sign out" })).toBeFocused();
+  await page.keyboard.press("Space");
+  expect(await acted(page)).toEqual(["sign-out"]);
+  registerCovered(REGISTRY, "sign-out-with-no-account-read-by-keyboard");
+});
+
+test("every registered account-unread action has its own proving test case above", () => {
+  assertAllCovered("ACCOUNT_UNREAD_ACTIONS", ACCOUNT_UNREAD_ACTIONS);
+});
