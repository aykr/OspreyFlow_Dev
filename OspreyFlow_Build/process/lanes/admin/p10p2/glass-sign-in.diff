diff --git a/OspreyFlow_Core/apps/workspace/src/App.test.tsx b/OspreyFlow_Core/apps/workspace/src/App.test.tsx
index 4ed79b8..20664d9 100644
--- a/OspreyFlow_Core/apps/workspace/src/App.test.tsx
