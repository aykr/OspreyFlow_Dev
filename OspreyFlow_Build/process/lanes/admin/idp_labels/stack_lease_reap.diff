+    if [ -n "$nets" ]; then docker network rm $nets >/dev/null 2>&1; fi
+    if [ "$c" -gt 0 ]; then echo "Removed $c container(s) the run left in Docker, and their network(s) ($tag)." >&2; fi
+  fi
