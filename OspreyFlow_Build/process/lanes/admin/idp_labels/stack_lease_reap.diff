   local tag="$1" p pid hit="" n=0
@@ -222,6 +225,14 @@ REAPER='osprey_reap() {
   if [ -n "$hit" ]; then sleep 2; for pid in $hit; do if osprey_tagged "$pid"; then kill -9 "$pid" 2>/dev/null; fi; done; fi
   OSPREY_REAPED=$n
