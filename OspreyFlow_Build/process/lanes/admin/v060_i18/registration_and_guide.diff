diff --git a/OspreyFlow_Build/tests/test_admin_guide_run_app_role.py b/OspreyFlow_Build/tests/test_admin_guide_run_app_role.py
new file mode 100644
index 0000000..ae250d9
--- /dev/null
+++ b/OspreyFlow_Build/tests/test_admin_guide_run_app_role.py
@@ -0,0 +1,43 @@
+"""The administration guide's §6a.7 on the run API's app role as the code has it (ADR-148 Amendment 20, v0.6.0 #18;
+rule 12): the refusal the guide quotes is the Conduit's own words, the role it names is `principal_auth`'s, and the poc
+manifest's API registration lists it. Each read from the code, so a change of words or name in one place and not the
+other fails here, and the guide's first draft, which sent an administrator to the wrong Entra blade, is refused.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+import yaml
+
+CORE = Path(__file__).resolve().parents[2] / "OspreyFlow_Core"
+#: The first draft's words, which named the API's own registration (App roles) instead of the orchestrator's.
+OLD_WORDS = "assign it to the application (the API's registration, App roles), then sign in again"
+
+
+def fold(text: str) -> str:
+    return re.sub(r"\s+", " ", text)
+
+
+def guide() -> str:
+    text = (CORE / "docs" / "administration-guide.md").read_text(encoding="utf-8")
+    return fold(re.sub(r"<!-- document-control:begin -->.*?<!-- document-control:end -->", " ", text, flags=re.DOTALL))
+
+
+def test_the_guide_quotes_the_run_apis_own_refusal() -> None:
+    from services.api.service_identity import RUN_ROLE_NOT_HELD
+
+    assert f'"{RUN_ROLE_NOT_HELD}"' in guide()
+
+
+def test_the_guide_and_the_manifest_name_principal_auths_role() -> None:
+    from principal_auth import RUN_APP_ROLE
+
+    assert f"app role `{RUN_APP_ROLE}`" in guide()
+    manifest = yaml.safe_load((CORE / "harness/cloud_platform/poc_manifest.yaml").read_text(encoding="utf-8"))
+    assert RUN_APP_ROLE in manifest["entra"]["api"]["app_roles"]
+
+
+def test_the_first_drafts_wrong_blade_is_gone() -> None:
+    assert OLD_WORDS not in guide()
