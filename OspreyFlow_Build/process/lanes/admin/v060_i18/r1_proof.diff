+def app_token(client: str, service_principal: str, roles: list[str] | None) -> str:
+    """An app-only token of the stand-in tenant for this API, shaped as the stand-in issues one by client
+    credentials (r1_kind_servers.py `_client_credentials`; `roles` left out when the application holds none, as
+    Entra does), signed with the tenant's own key."""
+    c = yaml.safe_load(CONFIG.read_text())["cloud_platform"]["claims"]
+    return token(oid=service_principal, sub=service_principal, azp=client, azpacr="1", idtyp="app",
+                 roles=roles, scp=None, name=None, preferred_username=None,
+                 **{c["clearance"]["claim"]: None, "groups": None})
+
+
+def run_api_role_checks(c: Any, ok: Any) -> None:
+    """ADR-148 Amendment 20 on the live Conduit: the run API admits an orchestrator holding OspreyFlow.Run, and
+    refuses in words an application of the tenant holding no app role, the report sync's dashboard identity and
+    the Glass's own client. A run that does not exist is asked for: past the service identity it is a 404."""
+    extra = yaml.safe_load((HERE / "r1_kind_entra.yaml").read_text())
+    claims = yaml.safe_load(CONFIG.read_text())["cloud_platform"]["claims"]
+    o, u, d = extra["orchestrator"], extra["orchestrator-unassigned"], extra["report-sync"]
+    ask = lambda bearer: c.get("/v1/runs/r1-no-such-run", headers={"Authorization": f"Bearer {bearer}"})  # noqa: E731
+    r = ask(app_token(o["client_id"], o["service_principal"], o["roles"]))
+    ok("the run API admits an orchestrator holding OspreyFlow.Run (past its door, the run is not found)",
+       r.status_code == 404, (r.status_code, r.text[:200]))
+    r = ask(app_token(u["client_id"], u["service_principal"], None))
+    ok("the run API refuses an application holding no app role, in words",
+       r.status_code == 403 and "does not hold this API's OspreyFlow.Run app role" in r.text, (r.status_code, r.text[:200]))
+    r = ask(app_token(d["client_id"], d["service_principal"], d["roles"]))
+    ok("the run API refuses the report sync's dashboard identity", r.status_code == 403, (r.status_code, r.text[:200]))
+    r = ask(app_token(claims["client_id"], d["service_principal"], ["OspreyFlow.Run"]))
+    ok("the run API refuses the Glass's own client, whatever roles it holds", r.status_code == 403, (r.status_code, r.text[:200]))
+
+
