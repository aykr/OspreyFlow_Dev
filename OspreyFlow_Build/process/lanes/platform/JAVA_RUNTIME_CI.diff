 # Phase 0's exit criterion: CI green; a GPL dependency fails; a schema drift fails. Core's own
 # gates first (lint, type check, image scans, the harness's accessibility suite), then these.
-ci: core-check lint-tools licence-check design-check ui-words-check opentofu-check chart-check schemas-check authorized-query-check demo-guide-check domain-model-coverage-check route-coverage-check product-tree-link-check decision-log-publication-check provenance-annotation-check test-file-coverage-check citation-check conformance-guard lanes-check confinement-check no-branches-check bundle
+ci: core-check java-runtime-check lint-tools licence-check design-check ui-words-check opentofu-check chart-check schemas-check authorized-query-check demo-guide-check domain-model-coverage-check route-coverage-check product-tree-link-check decision-log-publication-check provenance-annotation-check test-file-coverage-check citation-check conformance-guard lanes-check confinement-check no-branches-check bundle
 
 # ADR-142: the lease, the heartbeat, the launcher, the friction assembler, the reservation check and the
 # widened spec scan, each shown red first (rule 15); the reservation check also runs over the real log.
@@ -39,6 +39,13 @@ no-branches-check:
 core-check:
 	$(MAKE) -C $(CORE) check
 
+# ADR-147 Amendment 2: `trivy image` does not see the Conduit image's jlinked Java, so the image
+# `core-check`'s `trivy-image-api` has just built (`ospreyflow/api:ci`) is held to its Dockerfile's
+# declared Java version (`/opt/java/release`, `java -version`), and its pin to the digest its tag
+# resolves to on Docker Hub now. Here, not in Core's Makefile: Core stands alone (ADR-114 Amendment 2).
+java-runtime-check: core-check
+	$(IN_CORE) $(TOOLS) $(PY) -m tools.java_runtime_check --image ospreyflow/api:ci --current
+
 # This folder's own Node checks, linted with the product's ESLint configuration.
 lint-tools:
 	$(CORE)/node_modules/.bin/eslint -c $(CORE)/eslint.config.js tools
