+# A synthetic cloud-platform deployment for `make cp-policy-check` (ADR-140 Amendment 21): the
+# development namespace with one S3 bucket and one Athena workgroup declared, so the Conduit's own
+# egress rows for them, the IAM role's read statements and their networks render and are checked.
+profile: cloud-platform
+components:
+  analytics_engine: clickhouse
+network:
+  public_origin: https://ospreyflow-dev.apps.example.org
+cloud_platform:
+  platform: client
+  namespace: ospreyflow-dev
+  environment: development
+  registry: 123456789012.dkr.ecr.eu-west-2.amazonaws.com
+  allow_from: ["192.0.2.0/24"]
+  # S3 and STS by their networks (synthetic): the bucket and IRSA's role, on every render.
+  egress_nets:
+    s3.eu-west-2.amazonaws.com: ["198.18.0.0/24"]
+    sts.eu-west-2.amazonaws.com: ["198.18.1.0/24"]
+    # The declared bucket and Athena, by their networks (synthetic): the Conduit's alone.
+    synthetic-exports.s3.eu-west-2.amazonaws.com: ["198.18.0.0/24"]
+    athena.eu-west-2.amazonaws.com: ["198.18.3.0/24"]
+  # What S3 and Athena connections may read (synthetic names): Admin refuses any other.
+  connector_sources:
+    s3:
+    - {bucket: synthetic-exports, region: eu-west-2, prefix: client-a/}
+    athena:
+    - workgroup: analysts
+      region: eu-west-2
+      databases: [visits]
+      results_location: s3://synthetic-athena-results/out/
+      table_locations: [s3://synthetic-lake/visits/]
+# The map the Conduit reads at start: tier 1, the local OpenStreetMap file (synthetic deployment).
+map:
+  default: osm-local
+  providers:
+  - id: osm-local
+    label: OpenStreetMap
+    kind: vector
+    licence: {id: ODbL, redistributable: true, client_scope: open}
+    source: file:///data/tiles/osm-local.pmtiles
+    variables: {}
+    proxy: none
+    style: bundled:osprey-dark
+    attribution: "\xA9 OpenStreetMap contributors"
