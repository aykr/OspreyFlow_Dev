+def test_an_administrator_deletes_a_removed_cases_layer_and_never_an_open_ones(
+    pw: SimpleNamespace, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Admin's own Delete (Admin › Datasets): an open case's layer answers 404 and nothing is
+    withdrawn; once the case is removed, its layer goes, audited before it is written."""
+    monkeypatch.setitem(PEOPLE, "ada", Principal(
+        id="ada", clearance="SECRET", org_unit=UNIT, roles=["osprey-admin"]
+    ))  # fmt: skip
+    board = _board()
+    drawn = _item(board)
+    refused = _as("ada").post(f"/v1/admin/datasets/src/cases/{K}/delete")
+    assert refused.status_code == 404, refused.text
+    assert not pw.graph.node(drawn["element_id"]).audit.reverted
+    pw.removed.add(K)
+    deleted = _as("ada").post(f"/v1/admin/datasets/src/cases/{K}/delete")
+    assert deleted.status_code == 200, deleted.text
+    assert set(deleted.json()) == {"investigation_id", "words"}
+    assert pw.graph.node(drawn["element_id"]).audit.reverted
+    assert "delete_layer" in [r["action"] for r in pw.audit.records]
+
+
+def test_admin_delete_is_deployment_wide_as_admin_datasets_is(pw: SimpleNamespace) -> None:
+    """Rule 4 at the unit boundary (the independent review of L3.4, must-fix 8): Admin › Datasets
+    lists every dataset of the deployment (ADR-136 decision 2), and its Delete, like its dry run,
+    is an administrator's whatever their unit; another unit's person without `administer_system`
+    is refused before anything is read."""
+    PEOPLE["ada9"] = Principal(id="ada9", clearance="SECRET", org_unit="unit-2", roles=["osprey-admin"])
+    try:
+        board = _board()
+        drawn = _item(board)
+        pw.removed.add(K)
+        refused = _as("zed").post(f"/v1/admin/datasets/src/cases/{K}/delete")
+        assert refused.status_code == 403 and not pw.graph.node(drawn["element_id"]).audit.reverted
+        deleted = _as("ada9").post(f"/v1/admin/datasets/src/cases/{K}/delete")
+        assert deleted.status_code == 200, deleted.text
+        assert pw.graph.node(drawn["element_id"]).audit.reverted
+    finally:
+        del PEOPLE["ada9"]
 
 
