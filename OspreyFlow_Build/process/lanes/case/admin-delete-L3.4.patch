+def test_an_administrator_deletes_a_removed_cases_layer_and_never_an_open_ones(
+    pw: SimpleNamespace, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """Admin's own Delete (Admin › Datasets): an open case's layer answers 404 and nothing is
+    withdrawn; once the case is removed, its layer goes, audited before it is written."""
+    monkeypatch.setitem(PEOPLE, "ada", Principal(
+        id="ada", clearance="SECRET", org_unit=UNIT, roles=["osprey-admin"]
+    ))  # fmt: skip
+    board = _board()
+    drawn = _item(board)
+    refused = _as("ada").post(f"/v1/admin/datasets/src/cases/{K}/delete")
+    assert refused.status_code == 404, refused.text
+    assert not pw.graph.node(drawn["element_id"]).audit.reverted
+    pw.removed.add(K)
+    deleted = _as("ada").post(f"/v1/admin/datasets/src/cases/{K}/delete")
+    assert deleted.status_code == 200, deleted.text
+    assert set(deleted.json()) == {"investigation_id", "words"}
+    assert pw.graph.node(drawn["element_id"]).audit.reverted
+    assert "delete_layer" in [r["action"] for r in pw.audit.records]
+
+
+def test_admin_delete_is_scoped_to_the_datasets_unit(pw: SimpleNamespace) -> None:
+    """Rule 4 at the unit boundary (the independent review's round 2, item 1; the owner's ruling
+    of 9 November 2026): Admin's Delete is a destructive write with no undo, so only an administrator
+    of the dataset's current unit makes it. Another unit's administrator is answered exactly as
+    for a dataset that does not exist, and nothing is withdrawn; another unit's person without
+    `administer_system` is refused by the right first."""
+    PEOPLE["ada9"] = Principal(id="ada9", clearance="SECRET", org_unit="unit-2", roles=["osprey-admin"])
+    try:
+        board = _board()
+        drawn = _item(board)
+        pw.removed.add(K)
+        assert _as("zed").post(f"/v1/admin/datasets/src/cases/{K}/delete").status_code == 403
+        other = _as("ada9").post(f"/v1/admin/datasets/src/cases/{K}/delete")
+        unknown = _as("ada9").post(f"/v1/admin/datasets/no-such/cases/{K}/delete")
+        assert other.status_code == unknown.status_code == 404
+        assert other.json() == unknown.json()
+        assert not pw.graph.node(drawn["element_id"]).audit.reverted
+        assert "delete_layer" not in [r["action"] for r in pw.audit.records]
+    finally:
+        del PEOPLE["ada9"]
 
 
