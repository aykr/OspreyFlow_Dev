+// ADR-145 Amendment 4 decision 9 (L2.12): See the trend opens the Alert monitoring board filtered to
+// the alert's rule group and the period that holds it.
+test("See the trend is pressed on an alert by keyboard", async ({ page }) => {
+  await page.goto("/keyboard/rules-place-harness.html?address=a1");
+  await press(page, page.getByRole("button", { name: "See the trend" }));
+  const trend = (await page.evaluate(() => window.__RULES__?.trend)) as { rule: { label: string } }[];
+  expect(trend).toHaveLength(1);
+  expect(trend[0]!.rule.label).toBe("typology");
+  registerCovered(REGISTRY, "see-the-trend-on-an-alert-by-keyboard");
+});
+
 test("every registered Rules and Monitoring action has its own proving test case above", () => {
   assertAllCovered("RULES_PLACE_ACTIONS", RULES_PLACE_ACTIONS);
 });
