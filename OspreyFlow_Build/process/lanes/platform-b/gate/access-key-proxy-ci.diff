           --ignore=../OspreyFlow_Build/tests/conformance/model_port --ignore=../OspreyFlow_Build/tests/golden --ignore=../OspreyFlow_Build/tests/ingest
           --ignore=../OspreyFlow_Build/tests/services/api/test_valkey_store.py
           --ignore=../OspreyFlow_Build/tests/services/api/test_ws_ticket.py
