+def _window_root(tmp_path: Path, listed: bool) -> Path:
+    """A product root holding what the window check reads: the real lockfile and a window file. First `apps/pages`'s own
+    pins of a drawing library are taken out (it has none while the checkout's window is shut). `listed`: `apps/pages`
+    then pins Sigma 4.0.6 exactly, nested under it as npm writes such a pin, and the window lists that difference, so
+    the merge check passes and only a release is refused. Not listed: no difference, with `windows: []`."""
+    lock = json.loads((release_local.REPO_ROOT / "package-lock.json").read_text(encoding="utf-8"))
+    for field in ("dependencies", "devDependencies", "optionalDependencies", "peerDependencies"):
+        declared = lock["packages"]["apps/pages"].get(field, {})
+        for name in [n for n in declared if re.fullmatch(r"sigma|@sigma/[^/]+|maplibre-gl|graphology", n)]:
+            del declared[name]
+            lock["packages"].pop(f"apps/pages/node_modules/{name}", None)
+    window = "windows: []\n"
+    if listed:
+        workspace = lock["packages"]["node_modules/sigma"]["version"]
+        lock["packages"]["apps/pages"].setdefault("devDependencies", {})["sigma"] = "4.0.6"
+        lock["packages"]["apps/pages/node_modules/sigma"] = {"version": "4.0.6", "dev": True, "license": "MIT"}
+        window = (f"windows:\n  - package: sigma\n    apps/workspace: {workspace}\n    apps/pages: 4.0.6\n"
+                  "    opened: 2026-11-26\n")  # fmt: skip
+    root = tmp_path / "product"
+    (root / "apps/pages").mkdir(parents=True)
+    (root / "package-lock.json").write_text(json.dumps(lock), encoding="utf-8")
+    (root / "apps/pages/VERSION_WINDOW.yaml").write_text(window, encoding="utf-8")
+    return root
+
+
+def _past_the_other_refusals(monkeypatch: pytest.MonkeyPatch, root: Path) -> list[object]:
+    """`main()` with GitHub green and the register settled (each has its own cases), reading `root`, and with
+    everything that builds, pulls or packs recorded rather than run."""
+    monkeypatch.setattr(release_local, "git_sha", lambda: COMMIT)
+    monkeypatch.setattr(release_local, "green_refusal", lambda sha: None)
+    monkeypatch.setattr(release_local, "register_refusal", lambda: None)
+    monkeypatch.setattr(release_local, "REPO_ROOT", root)
+    ran: list[object] = []
+    monkeypatch.setattr(release_local, "_run", lambda *a, **k: ran.append(a))
+    monkeypatch.setattr(release_local, "build_and_scan", lambda *a, **k: ran.append(a) or [])
+    monkeypatch.setattr(release_local, "lock", lambda *a, **k: ran.append(a))
+    return ran
+
+
+def test_release_local_refuses_before_building_anything_while_the_version_window_lists_anything(
+    line: Path, tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    ran = _past_the_other_refusals(monkeypatch, _window_root(tmp_path, listed=True))
+    assert release_local.main(["--dry-run", "--tag", "v9.9.9", "--out", str(line / "out")]) == 1
+    assert ran == []
+    assert not (line / "out").exists()
+    err = capsys.readouterr().err
+    assert "the version window is open" in err
+    assert "no release while apps/pages/VERSION_WINDOW.yaml lists anything" in err
+    assert "sigma (" in err and "4.0.6 in apps/pages, opened 2026-11-26)" in err
+
+
+def test_release_local_goes_on_while_the_version_window_is_empty(
+    line: Path, tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    ran = _past_the_other_refusals(monkeypatch, _window_root(tmp_path, listed=False))
+    assert release_local.main(["--dry-run", "--tag", "v9.9.9", "--out", str(line / "out")]) == 0
+    assert ran != []
+    assert "refusing" not in capsys.readouterr().err
+
