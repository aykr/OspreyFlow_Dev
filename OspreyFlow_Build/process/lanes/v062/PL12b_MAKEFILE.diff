+def test_the_theme_rule_check_names_the_design_package_and_the_pages_roots() -> None:
+    """The check's roots hold the three design files, the pages roots and every root the brief
+    names, and each is a folder that exists (a renamed root is an error in the tool, not blindness)."""
+    roots = [CORE / top for top in theme_rule_check.SCAN_ROOTS]
+    for name in THE_THREE:
+        assert _under(DESIGN / name, roots), f"theme_rule_check skips packages/design/{name}"
+    named = (
+        "apps/workspace/src",
+        "apps/workspace/scripts",
+        "apps/harness/src",
+        "packages/glass-shared/src",
+    )
+    for top in (*PAGES_ROOTS, *named):
+        assert _under(CORE / top, roots), f"theme_rule_check skips {top}"
+        assert (CORE / top).is_dir(), f"{top} is not a folder: the check is blind there"
+
+
+def test_the_theme_rule_check_reads_packages_design(planted: Path) -> None:
+    # The shape the real rules have: a brand block in a stylesheet of the design package's folder.
+    planted.write_text('[data-brand="govuk"] .planted { margin: 0; }\n', encoding="utf-8")
+    core = planted.parent.parent.parent  # the copy is `<tmp>/packages/design`: its root is `<tmp>`
+    for top in theme_rule_check.SCAN_ROOTS:  # the check refuses a root that is missing
+        (core / top).mkdir(parents=True, exist_ok=True)
+    for name in theme_rule_check.SIGN_IN_FILES:  # ... and a named sign-in file that is missing
+        (core / name).parent.mkdir(parents=True, exist_ok=True)
+        (core / name).write_text("", encoding="utf-8")
+    found = [f for f in theme_rule_check.find_theme_rules(core) if f.path.endswith(PLANT)]
+    assert [(f.path, f.key, f.kind) for f in found] == [
+        (f"packages/design/{PLANT}", '[data-brand="govuk"] .planted', "rule")
+    ]
