diff --git a/OspreyFlow_Core/.github/workflows/release.yml b/OspreyFlow_Core/.github/workflows/release.yml
index 1f76ebb..aa99971 100644
--- a/OspreyFlow_Core/.github/workflows/release.yml
+++ b/OspreyFlow_Core/.github/workflows/release.yml
@@ -69,7 +69,7 @@ jobs:
       # Scanned first, as the amd64 image, before anything is pushed.
       - name: Build for the scan
         run: |
-          docker buildx build --pull --platform linux/amd64 --load -f ${{ matrix.dockerfile }} \
+          docker buildx build --pull --build-arg OSPREY_UPGRADE_STAMP="$(date -u +%F)" --platform linux/amd64 --load -f ${{ matrix.dockerfile }} \
             -t "${{ steps.name.outputs.image }}:scan" "${{ matrix.context || '.' }}"
       - uses: aquasecurity/trivy-action@v0.24.0
         with:
@@ -86,7 +86,7 @@ jobs:
       - name: Build both platforms and push
         id: push
         run: |
-          docker buildx build --pull --platform linux/amd64,linux/arm64 --push \
+          docker buildx build --pull --build-arg OSPREY_UPGRADE_STAMP="$(date -u +%F)" --platform linux/amd64,linux/arm64 --push \
             -f ${{ matrix.dockerfile }} -t "${{ steps.name.outputs.image }}:$GITHUB_SHA" \
             --metadata-file meta.json "${{ matrix.context || '.' }}"
           echo "ref=${{ steps.name.outputs.image }}@$(jq -r '."containerimage.digest"' meta.json)" >> "$GITHUB_OUTPUT"
